{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingy.ai/contracts/research-manifest-v1.schema.json",
  "title": "Kingy research product manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "slug", "title", "description", "product_type",
    "classification", "version", "version_scheme", "release_date", "status",
    "publication_authorized", "canonical_url", "repository_url", "creators",
    "publisher", "contact", "licenses", "methodology", "provenance", "disclosure",
    "privacy", "keywords", "platforms", "distributions", "charts", "release"
  ],
  "properties": {
    "schema_version": { "const": "kingy-research-manifest-v1" },
    "id": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 50, "maxLength": 5000 },
    "product_type": { "enum": ["dataset", "benchmark", "living-dataset", "report", "chart-collection", "bibliography", "software"] },
    "classification": { "enum": ["publish", "remediate", "restricted", "superseded", "archive-only"] },
    "version": { "type": "string", "pattern": "^v[0-9]{1,4}\\.[0-9]{1,2}\\.[0-9]+$" },
    "version_scheme": { "enum": ["calver", "semver"] },
    "release_date": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "local-candidate", "released", "deprecated"] },
    "publication_authorized": { "type": "boolean" },
    "canonical_url": { "$ref": "#/$defs/url" },
    "repository_url": { "$ref": "#/$defs/url" },
    "huggingface_url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
    "zenodo_url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
    "dois": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "version"],
      "properties": {
        "concept": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temporal": { "type": ["string", "null"] },
        "spatial": { "type": ["string", "null"] }
      }
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/person" }
    },
    "contributors": {
      "type": "array",
      "items": { "$ref": "#/$defs/person" }
    },
    "publisher": { "$ref": "#/$defs/organization" },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "code", "content", "rights_status"],
      "properties": {
        "data": { "type": "string", "minLength": 2 },
        "code": { "type": "string", "minLength": 2 },
        "content": { "type": "string", "minLength": 2 },
        "rights_status": { "enum": ["approved", "pending-review", "restricted"] }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "file", "population", "variables", "units", "exclusions", "limitations", "uncertainty"],
      "properties": {
        "summary": { "type": "string", "minLength": 20 },
        "file": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 3 },
        "variables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "units": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "uncertainty": { "type": "string", "minLength": 10 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_as", "is_based_on", "source_inventory"],
      "properties": {
        "same_as": { "type": "array", "items": { "$ref": "#/$defs/url" } },
        "is_based_on": { "type": "array", "items": { "$ref": "#/$defs/url" } },
        "source_inventory": { "type": "string", "minLength": 1 }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion", "funder", "commissioned_by", "prepublication_review",
        "editorial_control", "consideration", "conflicts", "interested_party_data",
        "ai_use", "independent_review", "limitations", "corrections", "review_status"
      ],
      "properties": {
        "conclusion": { "enum": ["Independently funded", "Editorially independent but sponsored", "Vendor-supplied data with independent analysis", "Not independent", "Pending accountable review"] },
        "funder": { "type": "string", "minLength": 2 },
        "commissioned_by": { "type": "string", "minLength": 2 },
        "prepublication_review": { "type": "string", "minLength": 2 },
        "editorial_control": { "type": "string", "minLength": 10 },
        "consideration": { "type": "string", "minLength": 2 },
        "conflicts": { "type": "string", "minLength": 2 },
        "interested_party_data": { "type": "string", "minLength": 2 },
        "ai_use": { "type": "string", "minLength": 10 },
        "independent_review": { "type": "string", "minLength": 2 },
        "limitations": { "type": "string", "minLength": 10 },
        "corrections": { "type": "string", "minLength": 10 },
        "review_status": { "enum": ["approved", "pending-review"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "personal_data", "consent", "copyright_status", "redistribution_status"],
      "properties": {
        "review_status": { "enum": ["approved", "pending-review", "restricted"] },
        "personal_data": { "type": "string", "minLength": 2 },
        "consent": { "type": "string", "minLength": 2 },
        "copyright_status": { "type": "string", "minLength": 2 },
        "redistribution_status": { "enum": ["approved", "pending-review", "prohibited"] }
      }
    },
    "keywords": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["website", "github", "huggingface", "zenodo"],
      "properties": {
        "website": { "type": "boolean" },
        "github": { "type": "boolean" },
        "huggingface": { "type": "boolean" },
        "zenodo": { "type": "boolean" }
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "encoding_format", "content_url", "role", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\r\\n]+$" },
          "encoding_format": { "type": "string", "minLength": 3 },
          "content_url": { "$ref": "#/$defs/url" },
          "role": { "enum": ["data", "report", "methodology", "schema", "source-manifest", "chart-data"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "summary", "alt", "csv", "svg", "png", "source_notes", "license"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 10 },
          "alt": { "type": "string", "minLength": 10 },
          "csv": { "type": "string", "minLength": 1 },
          "svg": { "type": "string", "minLength": 1 },
          "png": { "type": "string", "minLength": 1 },
          "source_notes": { "type": "string", "minLength": 3 },
          "license": { "type": "string", "minLength": 2 }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_summary", "update_cadence", "previous_version"],
      "properties": {
        "change_summary": { "type": "string", "minLength": 10 },
        "update_cadence": { "type": "string", "minLength": 2 },
        "previous_version": { "type": ["string", "null"] }
      }
    },
    "huggingface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "task_categories": { "type": "array", "items": { "type": "string" } },
        "size_category": { "type": "string" }
      }
    }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https://" },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "url": { "$ref": "#/$defs/url" },
        "ror": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "given_name", "family_name", "affiliation", "orcid", "roles", "identity_status"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "given_name": { "type": "string", "minLength": 1 },
        "family_name": { "type": "string", "minLength": 1 },
        "affiliation": { "type": "string", "minLength": 2 },
        "orcid": { "type": ["string", "null"], "pattern": "^https://orcid.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "identity_status": { "enum": ["confirmed", "pending-confirmation"] }
      }
    }
  }
}
